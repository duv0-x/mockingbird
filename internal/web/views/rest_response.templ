package views

import (
	"strings"

	"github.com/duv0-x/mockingbird/internal/domain"
)

// RestResponseView is the mock response editor (RestMockResponse.js,
// DESIGN.md §9.6). The whole editor is one form posted on Save.
type RestResponseView struct {
	IDs      RestIDs
	Method   domain.RestMethod
	Response domain.RestMockResponse
	// Params are the {names} of the resource URI (RestResourceParameters).
	Params []string
	Error  string
}

// Expressions listed in the help card (SPEC §4.4).
var Expressions = []string{
	`${RANDOM_UUID()}`,
	`${RANDOM_INTEGER(min=1, max=100)}`,
	`${RANDOM_STRING()}`,
	`${RANDOM_BOOLEAN()}`,
	`${RANDOM_DATE_TIME()}`,
	`${RANDOM_EMAIL()}`,
	`${RANDOM_ENUM(values=["A", "B"])}`,
	`${PATH_PARAMETER(parameter="id")}`,
	`${QUERY_STRING(query="name")}`,
	`${BODY_JSON_PATH(expression="$.id")}`,
	`${BODY_XPATH(expression="//id")}`,
	`${FAKER(api="name.firstName")}`,
}

templ RestResponsePage(p Page, v RestResponseView) {
	@Layout(p) {
		<form id="response-form" method="post" action={ p.SafeURL(v.IDs.ResponsePath()) } data-dirty-track>
			@Header(PageHead{
				Title:   v.Response.Name,
				Badges:  responseBadges(v.Response),
				Actions: responseActions(p, v),
			})
			@FormError(v.Error)
			<fieldset class="grid-detail" style="border:0;margin:0;padding:0;min-width:0" disabled?={ !p.CanModify() }>
				<div class="stack">
					<div class="codebox">
						<div class="codebox__head">
							<span class="codebox__title">Body</span>
							<span class="codebox__tools">
								<span class="badge badge-strategy">{ BodyLang(v.Response) }</span>
								<button type="button" class="btn btn--ghost btn--sm" data-format="mr-body">
									@Icon("align-left")
									Format
								</button>
								<button type="button" class="btn btn--ghost btn--sm" data-wrap="mr-body" aria-pressed="false">
									@Icon("wrap")
									Wrap
								</button>
								@CopyButton(v.Response.Body)
							</span>
						</div>
						<label class="sr-only" for="mr-body">Body</label>
						<textarea class="code code--edit" id="mr-body" name="body" rows="18" spellcheck="false" wrap="off">{ v.Response.Body }</textarea>
					</div>
					<div class="card">
						@TabList("Matching and headers", []Tab{
							{ID: "headers", Label: "Headers", Count: len(v.Response.HTTPHeaders)},
							{ID: "params", Label: "Parameter queries", Count: len(v.Response.ParameterQueries)},
							{ID: "hqueries", Label: "Header queries", Count: len(v.Response.HeaderQueries)},
							{ID: "jsonpath", Label: "JSON Path", Count: len(v.Response.JSONPathExpressions)},
							{ID: "xpath", Label: "XPath", Count: len(v.Response.XPathExpressions)},
						}, "headers")
						<div class="card__body">
							<div id="panel-headers" role="tabpanel" aria-labelledby="tab-headers">
								@headersEditor(v.Response.HTTPHeaders)
							</div>
							<div id="panel-params" role="tabpanel" aria-labelledby="tab-params" hidden>
								@paramQueriesEditor(v.Response.ParameterQueries, v.Params)
							</div>
							<div id="panel-hqueries" role="tabpanel" aria-labelledby="tab-hqueries" hidden>
								@headerQueriesEditor(v.Response.HeaderQueries)
							</div>
							<div id="panel-jsonpath" role="tabpanel" aria-labelledby="tab-jsonpath" hidden>
								@expressionsEditor("jp", "JSON Path expression", "$.customer.tier", jsonPaths(v.Response.JSONPathExpressions), "Used by the JSON Path strategy: the response matches when an expression finds a value in the request body.")
							</div>
							<div id="panel-xpath" role="tabpanel" aria-labelledby="tab-xpath" hidden>
								@expressionsEditor("xp", "XPath expression", "//customer[@tier='vip']", xpaths(v.Response.XPathExpressions), "Used by the XPath strategy: the response matches when an expression matches the request body.")
							</div>
						</div>
					</div>
				</div>
				<div class="stack">
					<div class="card">
						<div class="card__head"><h2 class="card__title">Settings</h2></div>
						<div class="card__body form">
							@FormField(Field{Label: "Name", For: "mr-name"}) {
								@TextInput(Input{ID: "mr-name", Name: "name", Value: v.Response.Name, Required: true})
							}
							@FormField(Field{Label: "HTTP status code", For: "mr-status-code"}) {
								<div class="input-group">
									<input class="input input--mono" type="number" min="100" max="599" id="mr-status-code" name="httpStatusCode" value={ Itoa(v.Response.HTTPStatusCode) } required/>
									<span class="input-group__suffix">{ StatusText(v.Response.HTTPStatusCode) }</span>
								</div>
							}
							@SwitchRow("mr-enabled", "enabled", "Enabled", v.Response.Status != domain.RestMockResponseDisabled)
							@SwitchRow("mr-expressions", "usingExpressions", "Use expressions", domain.Deref(v.Response.UsingExpressions))
						</div>
					</div>
					<div class="card">
						<div class="card__head">
							<h2 class="card__title">Expressions</h2>
							<button type="button" class="btn btn--secondary btn--sm" hx-get={ p.URL(v.IDs.ResponsePath() + "/validate") } hx-target="#modal-root">
								@Icon("play")
								Validate
							</button>
						</div>
						<div class="card__body exprlist">
							for _, ex := range Expressions {
								<div class="exprlist__item">
									<span title={ ex }>{ ex }</span>
									<button type="button" class="btn btn--ghost btn--sm btn--icon" data-insert={ ex } data-target="mr-body" aria-label={ "Insert " + ex }>
										@Icon("plus")
									</button>
								</div>
							}
							<p class="field__help">Expressions are evaluated when "Use expressions" is on.</p>
						</div>
					</div>
				</div>
			</fieldset>
			if p.CanModify() {
				<div class="savebar">
					<span class="savebar__state" data-dirty-state>All changes saved</span>
					<span class="toolbar__right">
						<a class="btn btn--secondary" href={ p.SafeURL(v.IDs.ResponsePath()) }>Discard changes</a>
						<button type="submit" class="btn btn--primary">
							@Icon("check")
							Save response
						</button>
					</span>
				</div>
			}
		</form>
		@rowTemplates(v.Params)
	}
}

templ responseBadges(r domain.RestMockResponse) {
	@StatusBadge(r.HTTPStatusCode)
	@ResponseBadge(string(r.Status))
}

templ responseActions(p Page, v RestResponseView) {
	if p.CanModify() {
		<button type="button" class="btn btn--secondary" hx-get={ p.URL(v.IDs.MethodPath() + "/mockresponse/duplicate?ids=" + v.Response.ID) } hx-target="#modal-root">
			@Icon("copy")
			Duplicate
		</button>
		<button type="button" class="btn btn--danger-ghost" hx-get={ p.URL(v.IDs.ResponsePath() + "/delete") } hx-target="#modal-root">
			@Icon("trash")
			Delete
		</button>
	}
}

// ---------- Row editors (DESIGN.md §7.7) ----------

templ headersEditor(hs []domain.HTTPHeader) {
	<table class="kvedit">
		<thead><tr><th>Name</th><th></th><th>Value</th><th><span class="sr-only">Remove</span></th></tr></thead>
		<tbody id="rows-h" data-next={ Itoa(len(hs)) }>
			for i, h := range hs {
				@headerRow(Itoa(i), h)
			}
		</tbody>
		<tfoot><tr><td colspan="4" class="kvedit__empty">No headers. The response is sent without custom headers.</td></tr></tfoot>
	</table>
	@addRowButton("tpl-h", "rows-h", "Add header")
}

templ headerRow(i string, h domain.HTTPHeader) {
	<tr>
		<td><input class="input input--mono" name={ "h[" + i + "].name" } value={ h.Name } placeholder="Content-Type" aria-label="Header name"/></td>
		<td class="kvedit__eq">=</td>
		<td><input class="input input--mono" name={ "h[" + i + "].value" } value={ h.Value } placeholder="application/json" aria-label="Header value"/></td>
		<td>
			@removeRowButton()
		</td>
	</tr>
}

templ paramQueriesEditor(qs []domain.RestParameterQuery, params []string) {
	<p class="field__help">Used by the Query match strategy: every query must match the request parameters.</p>
	<table class="kvedit">
		<thead>
			<tr>
				<th>Parameter</th>
				<th>Query</th>
				<th class="kvedit__flag">Match any</th>
				<th class="kvedit__flag">Match case</th>
				<th class="kvedit__flag">Regex</th>
				<th class="kvedit__flag">URL encoded</th>
				<th><span class="sr-only">Remove</span></th>
			</tr>
		</thead>
		<tbody id="rows-pq" data-next={ Itoa(len(qs)) }>
			for i, q := range qs {
				@paramQueryRow(Itoa(i), q, params)
			}
		</tbody>
		<tfoot><tr><td colspan="7" class="kvedit__empty">No parameter queries.</td></tr></tfoot>
	</table>
	@addRowButton("tpl-pq", "rows-pq", "Add parameter query")
}

templ paramQueryRow(i string, q domain.RestParameterQuery, params []string) {
	<tr>
		<td>
			if len(params) > 0 {
				<select class="select input--mono" name={ "pq[" + i + "].parameter" } aria-label="Parameter">
					for _, o := range paramOptions(params, q.Parameter) {
						<option value={ o } selected?={ o == q.Parameter }>{ o }</option>
					}
				</select>
			} else {
				<input class="input input--mono" name={ "pq[" + i + "].parameter" } value={ q.Parameter } placeholder="id" aria-label="Parameter"/>
			}
		</td>
		<td><input class="input input--mono" name={ "pq[" + i + "].query" } value={ q.Query } placeholder="42" aria-label="Query"/></td>
		@flagCell("pq["+i+"].matchAny", "Match any", q.MatchAny)
		@flagCell("pq["+i+"].matchCase", "Match case", q.MatchCase)
		@flagCell("pq["+i+"].matchRegex", "Regex", q.MatchRegex)
		@flagCell("pq["+i+"].urlEncoded", "URL encoded", q.URLEncoded)
		<td>
			@removeRowButton()
		</td>
	</tr>
}

templ headerQueriesEditor(qs []domain.RestHeaderQuery) {
	<p class="field__help">Used by the Header query match strategy: every query must match a request header.</p>
	<table class="kvedit">
		<thead>
			<tr>
				<th>Header</th>
				<th>Query</th>
				<th class="kvedit__flag">Match any</th>
				<th class="kvedit__flag">Match case</th>
				<th class="kvedit__flag">Regex</th>
				<th><span class="sr-only">Remove</span></th>
			</tr>
		</thead>
		<tbody id="rows-hq" data-next={ Itoa(len(qs)) }>
			for i, q := range qs {
				@headerQueryRow(Itoa(i), q)
			}
		</tbody>
		<tfoot><tr><td colspan="6" class="kvedit__empty">No header queries.</td></tr></tfoot>
	</table>
	@addRowButton("tpl-hq", "rows-hq", "Add header query")
}

templ headerQueryRow(i string, q domain.RestHeaderQuery) {
	<tr>
		<td><input class="input input--mono" name={ "hq[" + i + "].header" } value={ q.Header } placeholder="X-Tier" aria-label="Header"/></td>
		<td><input class="input input--mono" name={ "hq[" + i + "].query" } value={ q.Query } placeholder="vip" aria-label="Query"/></td>
		@flagCell("hq["+i+"].matchAny", "Match any", q.MatchAny)
		@flagCell("hq["+i+"].matchCase", "Match case", q.MatchCase)
		@flagCell("hq["+i+"].matchRegex", "Regex", q.MatchRegex)
		<td>
			@removeRowButton()
		</td>
	</tr>
}

templ expressionsEditor(prefix, label, placeholder string, exprs []string, help string) {
	<p class="field__help">{ help }</p>
	<table class="kvedit">
		<thead><tr><th>{ label }</th><th><span class="sr-only">Remove</span></th></tr></thead>
		<tbody id={ "rows-" + prefix } data-next={ Itoa(len(exprs)) }>
			for i, ex := range exprs {
				@expressionRow(prefix, Itoa(i), ex, placeholder, label)
			}
		</tbody>
		<tfoot><tr><td colspan="2" class="kvedit__empty">No expressions.</td></tr></tfoot>
	</table>
	@addRowButton("tpl-"+prefix, "rows-"+prefix, "Add expression")
}

templ expressionRow(prefix, i, ex, placeholder, label string) {
	<tr>
		<td><input class="input input--mono" name={ prefix + "[" + i + "].expression" } value={ ex } placeholder={ placeholder } aria-label={ label }/></td>
		<td>
			@removeRowButton()
		</td>
	</tr>
}

templ flagCell(name, label string, checked bool) {
	<td class="kvedit__flag"><input type="checkbox" name={ name } value="true" checked?={ checked } aria-label={ label }/></td>
}

templ removeRowButton() {
	<button type="button" class="btn btn--ghost btn--sm btn--icon" data-remove-row aria-label="Remove row">
		@Icon("trash")
	</button>
}

templ addRowButton(tpl, target, label string) {
	<button type="button" class="btn btn--secondary btn--sm" data-add-row={ tpl } data-target={ target }>
		@Icon("plus")
		{ label }
	</button>
}

// rowTemplates are cloned by "Add …" buttons; __i__ becomes a fresh index.
templ rowTemplates(params []string) {
	<template id="tpl-h">
		@headerRow("__i__", domain.HTTPHeader{})
	</template>
	<template id="tpl-pq">
		@paramQueryRow("__i__", domain.RestParameterQuery{}, params)
	</template>
	<template id="tpl-hq">
		@headerQueryRow("__i__", domain.RestHeaderQuery{})
	</template>
	<template id="tpl-jp">
		@expressionRow("jp", "__i__", "", "$.customer.tier", "JSON Path expression")
	</template>
	<template id="tpl-xp">
		@expressionRow("xp", "__i__", "", "//customer[@tier='vip']", "XPath expression")
	</template>
}

func paramOptions(params []string, current string) []string {
	out := append([]string{}, params...)
	if current != "" {
		for _, p := range params {
			if p == current {
				return out
			}
		}
		out = append(out, current)
	}
	return out
}

func jsonPaths(es []domain.RestJSONPathExpression) []string {
	out := make([]string, 0, len(es))
	for _, e := range es {
		out = append(out, e.Expression)
	}
	return out
}

func xpaths(es []domain.RestXPathExpression) []string {
	out := make([]string, 0, len(es))
	for _, e := range es {
		out = append(out, e.Expression)
	}
	return out
}

// BodyLang guesses the body language from Content-Type or the first byte.
func BodyLang(r domain.RestMockResponse) string {
	ct := HeaderValue(r.HTTPHeaders, "Content-Type")
	switch {
	case containsAny(ct, "json"):
		return "JSON"
	case containsAny(ct, "xml"):
		return "XML"
	}
	if b := strings.TrimSpace(r.Body); b != "" {
		switch b[0] {
		case '{', '[':
			return "JSON"
		case '<':
			return "XML"
		}
	}
	return "TEXT"
}

// ValidateForm is the "Validate expression" dialog (ValidateExpression).
type ValidateForm struct {
	Modal
	RequestBody string
	Output      string
	Validated   bool
	Error       string
}

templ ValidateDialog(v ValidateForm) {
	@ModalDialog(v.Modal) {
		@FormError(v.Error)
		<p class="muted">Renders the response body with its expressions against a sample request body.</p>
		@FormField(Field{Label: "Request body", For: "validate-request"}) {
			<textarea class="code code--wrap textarea--mono" id="validate-request" name="requestBody" rows="6" spellcheck="false">{ v.RequestBody }</textarea>
		}
		if v.Validated {
			@CodeBlock("Output", "", v.Output)
		}
	}
}
